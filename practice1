def find_student_by_name(students, name):
    for student in students:
        if student["name"].lower() == name.lower():
            print(f"{student['name']} - {student['age']} - {student['major']} - {student['gpa']}")
            return
    print('Student not found')
def count_students_by_major(students, major):
    count = 0
    for student in students:
        if student["major"].lower() == major.lower():
            count +=1
    print(f"There are {count} students in {major}")
def lowest_gpa(students):
    lowest_student=students[0]
    for student in students:
        if student["gpa"] < lowest_student["gpa"]:
            lowest_student = student
    print(f"{lowest_student['name']} - {lowest_student['gpa']}")
def highest_gpa(students):
    highest_student=students[0]
    for student in students:
        if student["gpa"] > highest_student["gpa"]:
            highest_student=student
    print(f"{highest_student['name']} - {highest_student['gpa']}")
        
def average_gpa(students):
    total_gpa = 0
    for student in students:
        total_gpa+=(student["gpa"])
    average=total_gpa/len(students)
    print(f"The average gpa is{average}")
    return

def update_student(students, name):
    for student in students:
        if student["name"].strip().lower() == name.strip().lower():
            print(f"Editing {student['name']}")
            new_age = input('Enter new age or press enter to keep current: ')
            if new_age !="":
                            student["age"] = int(new_age)
            new_major = input('Enter new major or press enter to keep current: ')
            if new_major != "":
                            student["major"] = new_major
            new_gpa = input('Enter new GPA or press enter to keep current: ')
           
           
            if new_gpa != "":
                student["gpa"] = float(new_gpa)
            print("Student updated.")
            return
    print("Student not found.")
        

def delete_student(students, name):
    for student in students:
        if student["name"].lower() == name.lower():
            students.remove(student)
            print("Student deleted.")
            return
    print("Student not found.")

def show_gpa(students, minimum_gpa):
    for student in students:
        if student["gpa"] >= minimum_gpa:
            print(f"{student['name']} - {student['age']} - {student['major']} - {student['gpa']} ")
def show_major(students, major):
    for student in students:
        if student["major"] == major:
            print(f"{student['name']} - {student['age']} - {student['major']}")
def show_students(students):
    for student in students:
        print(f"{student['name']} - {student['age']} - {student['major']} - {student['gpa']}")

def add_student(students):
    name=input("What is your name?")
    age=int(input("How old are you?"))
    major=input("What is your major?")
    gpa=float(input("What is your gpa?"))
    student = {
        "name": name,
        "age": age,
        "major": major,
        "gpa": gpa
    }
    students.append(student)

def find_students_by_major(students, major):
    matching_students =[]
    for student in students:
        if student["major"] == major:
            matching_students.append(student)
    return matching_students

